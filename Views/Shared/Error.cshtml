@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="page-header">
    <div class="container">
        <div class="ust-etiket">Beklenmeyen hata</div>
        <h2>Bir sorun oluştu</h2>
        <p class="lead mb-0">İsteğiniz işlenirken beklenmeyen bir hata oluştu.</p>
    </div>
</div>

<div class="container">
    <div class="card">
        <div class="card-body">
            <p class="card-text">Lütfen bir süre sonra yeniden deneyin veya ana sayfaya dönün.</p>
            <a class="btn btn-primary" href="/">Ana sayfaya dön</a>
            @if (Model.ShowRequestId)
            {
                <div class="kart-alt mt-3">İstek kimliği: <code>@Model.RequestId</code></div>
            }
        </div>
    </div>
</div>
