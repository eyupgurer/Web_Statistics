@model YokIstatistikWeb.Models.GenelBakisViewModel
@{
    ViewData["Title"] = "Genel Bakış";
}

<div class="page-header">
    <div class="container d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <div class="ust-etiket">Yükseköğretim Kurumları</div>
            <h2>Genel Bakış</h2>
            <p class="lead mb-0">@Model.YilGoster öğretim yılı</p>
        </div>
        <div class="text-lg-end" style="font-size:12.5px; color:var(--metin-ikincil); line-height:1.5;">
            Kaynak: YÖK Yükseköğretim İstatistikleri
        </div>
    </div>
</div>

<div class="container">

    @if (!Model.VeriVar)
    {
        <div class="alert alert-warning">
            <strong>@Model.YilGoster</strong> öğretim yılı için veritabanında kayıt bulunamadı.
            Veriyi yüklemek için <code>python -m yok_scraper seed</code> komutunu çalıştırın.
        </div>
    }
    else
    {
        <!-- KPI ŞERİDİ -->
        <div class="kpi-serit mb-4">
            <div class="kpi">
                <div class="kpi-etiket">Toplam kurum</div>
                <div class="kpi-deger num">@Model.ToplamKurum</div>
                <div class="kpi-alt">Devlet, vakıf ve vakıf MYO</div>
            </div>
            <div class="kpi">
                <div class="kpi-etiket">Öğretim elemanı</div>
                <div class="kpi-deger num">@Model.ToplamOgretimElemani.ToString("N0")</div>
                <div class="kpi-alt">Tüm kurumlar toplamı</div>
            </div>
            <div class="kpi">
                <div class="kpi-etiket">Kadın oranı</div>
                <div class="kpi-deger num">%@Model.KadinOrani.ToString("N1")</div>
                <div class="kpi-alt">@Model.ToplamKadin.ToString("N0") kadın öğretim elemanı</div>
            </div>
            <div class="kpi">
                <div class="kpi-etiket">Öğrenci</div>
                <div class="kpi-deger num">@(Model.OgrenciVar ? Model.ToplamOgrenci.ToString("N0") : "—")</div>
                <div class="kpi-alt">Tüm öğrenim düzeyleri</div>
            </div>
        </div>

        @if (Model.OgrenciVar)
        {
            <div class="card mb-4">
                <div class="kart-baslik">
                    <div class="card-title">Öğrenim düzeyine göre öğrenci</div>
                    <div class="kart-alt">
                        Önlisans ve lisans ile lisansüstü YÖK'te ayrı tablolarda yayımlanıyor
                    </div>
                </div>
                <div class="card-body">
                    @{
                        var duzeyler = new (string Ad, int Sayi, string Renk)[]
                        {
                            ("Önlisans ve lisans", Model.OnlisansLisansOgrenci, "var(--seri-1)"),
                            ("Yüksek lisans",      Model.YuksekLisans,          "var(--seri-2)"),
                            ("Doktora",            Model.Doktora,              "var(--seri-3)"),
                        }.Where(d => d.Sayi > 0).ToArray();
                        var duzeyToplam = Math.Max(Model.ToplamOgrenci, 1);
                    }
                    @foreach (var d in duzeyler)
                    {
                        var pay = (double)d.Sayi / duzeyToplam * 100;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-baseline mb-2">
                                <span class="d-flex align-items-center gap-2" style="font-size:13.5px;">
                                    <span class="seri-nokta" style="background:@d.Renk;"></span>@d.Ad
                                </span>
                                <span class="num" style="font-size:13.5px;">
                                    <strong>@d.Sayi.ToString("N0")</strong>
                                    <span style="color:var(--metin-soluk);">
                                        %@pay.ToString("N1", System.Globalization.CultureInfo.InvariantCulture)
                                    </span>
                                </span>
                            </div>
                            <div class="cubuk">
                                <div class="cubuk-dolu"
                                     style="width:@pay.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%; background:@d.Renk;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="row g-4">
            <!-- TÜR DAĞILIMI -->
            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="kart-baslik">
                        <div class="card-title">Türlerine göre kurumlar</div>
                        <div class="kart-alt">Kurum sayısı ve öğretim elemanı dağılımı</div>
                    </div>
                    <div class="card-body">
                        @foreach (var tur in Model.Turler)
                        {
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-baseline mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="seri-nokta" style="background:@tur.Renk;"></span>
                                        <span style="font-size:13.5px; font-weight:500;">@tur.Ad</span>
                                        <span class="num" style="font-size:12px; color:var(--metin-soluk);">
                                            @tur.KurumSayisi kurum
                                        </span>
                                    </div>
                                    <span class="num" style="font-size:13.5px; font-weight:600;">
                                        @tur.KisiSayisi.ToString("N0")
                                    </span>
                                </div>
                                <div class="cubuk">
                                    <div class="cubuk-dolu" style="width:@tur.Oran.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%; background:@tur.Renk;"></div>
                                </div>
                            </div>
                        }
                        <div class="d-flex justify-content-between align-items-baseline pt-3"
                             style="border-top:1px solid var(--cizgi-acik);">
                            <span style="font-size:13px; color:var(--metin-ikincil);">Toplam öğretim elemanı</span>
                            <span class="num" style="font-size:18px; font-weight:600;">@Model.ToplamOgretimElemani.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- UNVAN DAĞILIMI -->
            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="kart-baslik">
                        <div class="card-title">Akademik unvana göre</div>
                        <div class="kart-alt">Erkek ve kadın öğretim elemanı sayıları</div>
                    </div>
                    <div class="card-body">
                        <div class="lejant mb-3">
                            <span><i class="seri-nokta" style="background:var(--seri-1);"></i>Erkek</span>
                            <span><i class="seri-nokta" style="background:var(--seri-2);"></i>Kadın</span>
                        </div>

                        @foreach (var u in Model.Unvanlar)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-baseline mb-1">
                                    <span style="font-size:12.5px;">@u.Ad</span>
                                    <span class="num" style="font-size:12.5px; font-weight:600;">@u.Toplam.ToString("N0")</span>
                                </div>
                                <div class="yigin">
                                    <div style="width:@u.ErkekOrani.ToString("N1", System.Globalization.CultureInfo.InvariantCulture)%; background:var(--seri-1); border-radius:3px 0 0 3px;"></div>
                                    <div style="width:@u.KadinOrani.ToString("N1", System.Globalization.CultureInfo.InvariantCulture)%; background:var(--seri-2); border-radius:0 3px 3px 0;"></div>
                                </div>
                                <div class="num d-flex justify-content-between"
                                     style="font-size:11px; color:var(--metin-soluk); margin-top:4px;">
                                    <span>E @u.Erkek.ToString("N0")</span>
                                    <span>K @u.Kadin.ToString("N0")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
