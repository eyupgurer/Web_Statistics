@{
    ViewData["Title"] = $"{ViewBag.YilGoster} Yılı İstatistikleri";

    var yil = (string)ViewBag.Yil;
    var hazir = (Dictionary<string, bool>)ViewBag.Hazir;

    // Her kart: başlık, ikon, açıklama, veri anahtarı ve bağlantılar.
    var kartlar = new[]
    {
        new
        {
            Ad = "Öğretim Elemanları", Ikon = "fa-chalkboard-teacher",
            Aciklama = "Akademik unvan, cinsiyet ve birim kırılımında öğretim elemanı sayıları",
            Baglantilar = new[]
            {
                new { Ad = "Akademik Görevlere Göre", Aksiyon = "AkademikPersonel", Anahtar = "ogretim_elemani" },
                new { Ad = "Yabancı Uyruklu",         Aksiyon = "YabanciUyruklu",   Anahtar = "yabanci_uyruklu" },
            }
        },
        new
        {
            Ad = "Öğrenci Sayıları", Ikon = "fa-user-graduate",
            Aciklama = "Önlisans ve lisans düzeyinde öğrenci ve yeni kayıt sayıları",
            Baglantilar = new[]
            {
                new { Ad = "Kurumlara Göre", Aksiyon = "OgrenciSayilari", Anahtar = "ogrenci" },
            }
        },
        new
        {
            Ad = "Mezun Sayıları", Ikon = "fa-graduation-cap",
            Aciklama = "Önlisans ve lisans düzeyinde mezun sayıları",
            Baglantilar = new[]
            {
                new { Ad = "Kurumlara Göre", Aksiyon = "MezunSayilari", Anahtar = "mezun" },
            }
        },
        new
        {
            Ad = "Özet Tablolar", Ikon = "fa-table",
            Aciklama = "Türlerine göre akademik birim sayıları ve genel dağılımlar",
            Baglantilar = new[]
            {
                new { Ad = "Akademik Birim Sayıları", Aksiyon = "OzetTablolar", Anahtar = "ozet" },
            }
        },
    };
}

<div class="page-header">
    <div class="container">
        <div class="ust-etiket">Öğretim yılı</div>
        <h2>@ViewBag.YilGoster İstatistikleri</h2>
        <p class="lead mb-0">Bir veri grubu seçerek incelemeye başlayın</p>
    </div>
</div>

<div class="container">
    <div class="row g-4">
        @foreach (var kart in kartlar)
        {
            var kartHazir = kart.Baglantilar.Any(b => hazir.GetValueOrDefault(b.Anahtar));
            <div class="col-md-6 col-lg-3">
                <div class="card menu-card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">
                                <i class="fas @kart.Ikon me-2"></i>@kart.Ad
                            </h5>
                            <span class="badge @(kartHazir ? "bg-success" : "bg-secondary")">
                                @(kartHazir ? "Hazır" : "Yakında")
                            </span>
                        </div>
                        <p class="card-text">@kart.Aciklama</p>

                        <div class="d-grid gap-2 mt-auto">
                            @foreach (var bag in kart.Baglantilar)
                            {
                                if (hazir.GetValueOrDefault(bag.Anahtar))
                                {
                                    <a href="@Url.Action(bag.Aksiyon, "Yuksekogretim", new { year = yil })"
                                       class="btn btn-outline-primary">
                                        @bag.Ad
                                        <i class="fas fa-arrow-right ms-1" style="font-size:11px;"></i>
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary" disabled>
                                        <i class="fas fa-lock me-1"></i> @bag.Ad
                                    </button>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
