@{
    ViewData["Title"] = $"{ViewBag.YilGoster} Yılı İstatistikleri";

    // Şu an yalnızca öğretim elemanı verisi (YÖK tablo T028) yüklü.
    // Diğer üç grup için ham dosyalar indirildi ama ayrıştırıcıları henüz yazılmadı.
    // Var olmayan action'lara link vermek yerine durumu açıkça gösteriyoruz.
    var yil = (string)ViewBag.Yil;
}

<div class="container mt-4 mb-5">
    <div class="page-header mb-4">
        <h2 class="mb-1">@ViewBag.YilGoster Yılı İstatistikleri</h2>
        <p class="text-muted mb-0">Bir veri grubu seçerek incelemeye başlayın</p>
    </div>

    @if (ViewBag.VeriVar is false)
    {
        <div class="alert alert-warning">
            Bu öğretim yılı için veritabanında kayıt bulunamadı.
            Veriyi yüklemek için <code>python -m yok_scraper seed</code> komutunu çalıştırın.
        </div>
    }

    <div class="row g-4">
        <!-- Öğretim Elemanları — veri hazır -->
        <div class="col-md-6 col-lg-3">
            <div class="card menu-card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-chalkboard-teacher me-2"></i>Öğretim Elemanları
                        </h5>
                        <span class="badge bg-success">Hazır</span>
                    </div>
                    <p class="card-text">Akademik unvan, cinsiyet ve birim kırılımında öğretim elemanı sayıları</p>
                    <div class="d-grid gap-2 mt-auto">
                        <a href="@Url.Action("AkademikPersonel", "Yuksekogretim", new { year = yil })"
                           class="btn btn-outline-primary">
                            <i class="fas fa-chart-bar me-1"></i> Akademik Görevlere Göre
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Henüz ayrıştırıcısı yazılmamış gruplar -->
        @foreach (var grup in new[]
        {
            new { Ad = "Öğrenci Sayıları", Ikon = "fa-user-graduate", Tablo = 11,
                  Aciklama = "Öğrenim düzeyi, il/ilçe ve eğitim alanı kırılımında öğrenci sayıları" },
            new { Ad = "Mezun Sayıları", Ikon = "fa-graduation-cap", Tablo = 13,
                  Aciklama = "Mezuniyet istatistikleri; yaş, eğitim alanı ve kurum kırılımları" },
            new { Ad = "Özet Tablolar", Ikon = "fa-table", Tablo = 8,
                  Aciklama = "Kurum sayıları, akademik birim türleri ve genel dağılımlar" }
        })
        {
            <div class="col-md-6 col-lg-3">
                <div class="card menu-card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">
                                <i class="fas @grup.Ikon me-2"></i>@grup.Ad
                            </h5>
                            <span class="badge bg-secondary">Yakında</span>
                        </div>
                        <p class="card-text">@grup.Aciklama</p>
                        <div class="mt-auto">
                            <div class="text-muted small mb-2">
                                <i class="fas fa-info-circle me-1"></i>
                                @grup.Tablo tablo indirildi, ayrıştırma bekliyor
                            </div>
                            <button class="btn btn-outline-secondary w-100" disabled>
                                <i class="fas fa-lock me-1"></i> Hazırlanıyor
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
