@model YokIstatistikWeb.Models.KurumListesiViewModel
@using YokIstatistikWeb.Services
@{
    ViewData["Title"] = Model.Baslik;

    var turRenkleri = new Dictionary<string, string>
    {
        ["DEVLET"] = "var(--seri-1)", ["VAKIF"] = "var(--seri-2)", ["VAKIF MYO"] = "var(--seri-3)"
    };
    string TurRengi(string? t) => t is not null && turRenkleri.TryGetValue(t, out var r) ? r : "var(--metin-soluk)";

    var ilkOn = Model.Satirlar.OrderByDescending(s => s.AnaOlcum).Take(10).ToList();
    var enYuksek = Math.Max(ilkOn.Count > 0 ? ilkOn[0].AnaOlcum : 1, 1);
}

<div class="page-header">
    <div class="container">
        <div class="ust-etiket">@Model.YilGoster öğretim yılı</div>
        <h2>@Model.Baslik</h2>
        <p class="lead mb-0">@Model.Aciklama</p>
    </div>
</div>

<div class="container">

    @if (!Model.VeriVar && string.IsNullOrWhiteSpace(Model.Arama)
         && string.IsNullOrWhiteSpace(Model.SeciliSehir) && string.IsNullOrWhiteSpace(Model.SeciliTur))
    {
        <div class="alert alert-warning">
            <strong>@Model.YilGoster</strong> öğretim yılı için bu veri grubu yüklenmemiş.
            <code>python -m yok_scraper seed</code> komutunu çalıştırın.
        </div>
    }
    else
    {
        @if (Model.Kartlar.Any())
        {
            <div class="kpi-serit mb-4" style="grid-template-columns:repeat(@Model.Kartlar.Count,minmax(0,1fr));">
                @foreach (var k in Model.Kartlar)
                {
                    <div class="kpi">
                        <div class="kpi-etiket">@k.Etiket</div>
                        <div class="kpi-deger num">@k.Deger</div>
                        @if (!string.IsNullOrWhiteSpace(k.Alt))
                        {
                            <div class="kpi-alt">@k.Alt</div>
                        }
                    </div>
                }
            </div>
        }

        <form method="get" class="filter-form">
            <input type="hidden" name="year" value="@Model.Yil" />
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="search">Üniversite ara</label>
                    <input type="text" class="form-control" id="search" name="search"
                           value="@Model.Arama" placeholder="Ad ile ara…" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="tur">Tür</label>
                    <select class="form-select" id="tur" name="tur">
                        <option value="">Tümü</option>
                        @foreach (var t in Model.Turler)
                        {
                            <option value="@t" selected="@(t == Model.SeciliTur)">@IstatistikServisi.TurGoster(t)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="sehir">Şehir</label>
                    <select class="form-select" id="sehir" name="sehir">
                        <option value="">Tümü</option>
                        @foreach (var sh in Model.Sehirler)
                        {
                            <option value="@sh" selected="@(sh == Model.SeciliSehir)">@sh</option>
                        }
                    </select>
                </div>
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-primary">Filtrele</button>
                </div>
            </div>
        </form>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card">
                    <div class="kart-baslik d-flex justify-content-between align-items-baseline">
                        <div class="card-title">Kurumlar</div>
                        <span class="num" style="font-size:12.5px; color:var(--metin-ikincil);">
                            @Model.Satirlar.Count kurum
                        </span>
                    </div>

                    @if (!Model.VeriVar)
                    {
                        <div class="card-body">
                            <p class="card-text mb-0">Bu filtrelerle eşleşen kurum bulunamadı.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                <tr>
                                    <th>Üniversite</th>
                                    <th>Tür</th>
                                    <th>Şehir</th>
                                    @foreach (var b in Model.OlcumBasliklari)
                                    {
                                        <th class="text-end">@b</th>
                                    }
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var satir in Model.Satirlar)
                                {
                                    <tr>
                                        <td style="font-weight:500;">@satir.Universite</td>
                                        <td>
                                            <span class="d-inline-flex align-items-center gap-2"
                                                  style="font-size:12px; color:var(--metin-ikincil);">
                                                <span class="seri-nokta" style="background:@TurRengi(satir.Tur);"></span>
                                                @IstatistikServisi.TurGoster(satir.Tur)
                                            </span>
                                        </td>
                                        <td style="color:var(--metin-ikincil);">
                                            @(string.IsNullOrWhiteSpace(satir.Sehir) ? "—" : satir.Sehir)
                                        </td>
                                        @for (var i = 0; i < satir.Olcumler.Count; i++)
                                        {
                                            var sonKolon = i == satir.Olcumler.Count - 1;
                                            <td class="text-end num"
                                                style="@(sonKolon ? "font-weight:600;" : "color:var(--metin-ikincil);")">
                                                @satir.Olcumler[i].ToString("N0")
                                            </td>
                                        }
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                @* Yabancı uyruklu sayfasında ülke kırılımı da var (T201) *@
                @if (ViewBag.Ulkeler is List<YokIstatistikWeb.Models.UlkeKayit> ulkeler && ulkeler.Any())
                {
                    var ulkeToplam = ulkeler.Sum(u => u.toplam_toplam ?? 0);
                    var ulkeEnYuksek = Math.Max(ulkeler.First().toplam_toplam ?? 1, 1);
                    <div class="card mb-4">
                        <div class="kart-baslik d-flex justify-content-between align-items-baseline">
                            <div>
                                <div class="card-title">Uyruğa göre</div>
                                <div class="kart-alt">En çok öğretim elemanı gönderen ülkeler</div>
                            </div>
                            <span class="num" style="font-size:12.5px; color:var(--metin-ikincil);">
                                @ulkeler.Count ülke
                            </span>
                        </div>
                        <div class="card-body">
                            @foreach (var u in ulkeler.Take(12))
                            {
                                var ut = u.toplam_toplam ?? 0;
                                var uoran = (double)ut / ulkeEnYuksek * 100;
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-baseline gap-3 mb-1">
                                        <span style="font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                            @u.ulke
                                        </span>
                                        <span class="num" style="font-size:12px; font-weight:600; flex-shrink:0;">
                                            @ut.ToString("N0")
                                        </span>
                                    </div>
                                    <div class="cubuk" style="height:8px;">
                                        <div class="cubuk-dolu"
                                             style="width:@uoran.ToString("N1", System.Globalization.CultureInfo.InvariantCulture)%; background:var(--seri-3);"></div>
                                    </div>
                                </div>
                            }
                            <div class="pt-2 mt-2" style="border-top:1px solid var(--cizgi-acik); font-size:11.5px; color:var(--metin-soluk);">
                                @ulkeler.Count ülkeden toplam @ulkeToplam.ToString("N0") öğretim elemanı
                            </div>
                        </div>
                    </div>
                }

                <div class="card">
                    <div class="kart-baslik">
                        <div class="card-title">En yüksek 10 kurum</div>
                        <div class="kart-alt">@Model.OlcumBasliklari.Last()</div>
                    </div>
                    <div class="card-body">
                        @foreach (var s in ilkOn)
                        {
                            var oran = (double)s.AnaOlcum / enYuksek * 100;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-baseline gap-3 mb-1">
                                    <span style="font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                        @s.Universite
                                    </span>
                                    <span class="num" style="font-size:12px; font-weight:600; flex-shrink:0;">
                                        @s.AnaOlcum.ToString("N0")
                                    </span>
                                </div>
                                <div class="cubuk" style="height:8px;">
                                    <div class="cubuk-dolu"
                                         style="width:@oran.ToString("N1", System.Globalization.CultureInfo.InvariantCulture)%; background:var(--seri-1);"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
