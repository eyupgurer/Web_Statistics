@model YokIstatistikWeb.Models.ProgramAramaViewModel
@{
    ViewData["Title"] = "Programlar";
    var enYuksek = Math.Max(Model.Programlar.FirstOrDefault()?.Toplam ?? 1, 1);
}

<div class="page-header">
    <div class="container">
        <div class="ust-etiket">@Model.YilGoster öğretim yılı</div>
        <h2>Programlar</h2>
        <p class="lead mb-0">Program bazında öğrenci sayıları ve hangi kurumların sunduğu</p>
    </div>
</div>

<div class="container">

    @if (!Model.VeriVar && string.IsNullOrWhiteSpace(Model.Arama))
    {
        <div class="alert alert-warning">
            Program verisi yüklenmemiş. <code>python -m yok_scraper seed</code> çalıştırın.
        </div>
    }
    else
    {
        <form method="get" class="filter-form">
            <div class="row g-3 align-items-end">
                <div class="col-md-10">
                    <label class="form-label" for="search">Program ara</label>
                    <input type="text" class="form-control" id="search" name="search"
                           value="@Model.Arama" placeholder="Örneğin: bilgisayar mühendisliği, hukuk, hemşirelik…" />
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Ara</button>
                </div>
            </div>
        </form>

        <div class="row g-4">
            <div class="col-lg-@(Model.Kurumlar.Any() ? "6" : "12")">
                <div class="card">
                    <div class="kart-baslik d-flex justify-content-between align-items-baseline">
                        <div>
                            <div class="card-title">
                                @(string.IsNullOrWhiteSpace(Model.Arama) ? "En çok öğrencisi olan programlar" : $"“{Model.Arama}” sonuçları")
                            </div>
                            <div class="kart-alt">Ülke geneli toplamlar · bir programa tıklayın</div>
                        </div>
                        <span class="num" style="font-size:12.5px; color:var(--metin-ikincil);">
                            @Model.Programlar.Count program
                        </span>
                    </div>
                    <div class="card-body">
                        @if (!Model.Programlar.Any())
                        {
                            <p class="card-text mb-0">Bu aramayla eşleşen program bulunamadı.</p>
                        }
                        @foreach (var p in Model.Programlar)
                        {
                            var secili = p.Program == Model.SeciliProgram;
                            <a href="@Url.Action("Programlar", new { search = Model.Arama, program = p.Program })"
                               class="d-block mb-3" style="text-decoration:none; color:inherit;">
                                <div class="d-flex justify-content-between align-items-baseline gap-3 mb-1">
                                    <span style="font-size:12.5px; @(secili ? "font-weight:600;" : "")">
                                        @p.Program
                                        <span class="num" style="color:var(--metin-soluk); font-size:11px;">
                                            @p.KurumSayisi kurum
                                        </span>
                                    </span>
                                    <span class="num" style="font-size:12.5px; flex-shrink:0;">
                                        <strong>@p.Toplam.ToString("N0")</strong>
                                        <span style="color:var(--metin-soluk);">%@Bicim.Yuzde(p.KadinOrani) kadın</span>
                                    </span>
                                </div>
                                <div class="yigin" style="height:9px;">
                                    @{
                                        var oran = (double)p.Toplam / enYuksek * 100;
                                    }
                                    <div style="width:@Bicim.Css(oran * (100 - p.KadinOrani) / 100)%; background:var(--seri-1); border-radius:3px 0 0 3px;"></div>
                                    <div style="width:@Bicim.Css(oran * p.KadinOrani / 100)%; background:var(--seri-2); border-radius:0 3px 3px 0;"></div>
                                </div>
                            </a>
                        }
                        <div class="lejant mt-3 pt-3" style="border-top:1px solid var(--cizgi-acik);">
                            <span><i class="seri-nokta" style="background:var(--seri-1);"></i>Erkek</span>
                            <span><i class="seri-nokta" style="background:var(--seri-2);"></i>Kadın</span>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Kurumlar.Any())
            {
                <div class="col-lg-6">
                    <div class="card">
                        <div class="kart-baslik d-flex justify-content-between align-items-baseline">
                            <div>
                                <div class="card-title">@Model.SeciliProgram</div>
                                <div class="kart-alt">Bu programı sunan kurumlar</div>
                            </div>
                            <span class="num" style="font-size:12.5px; color:var(--metin-ikincil);">
                                @Model.Kurumlar.Count kurum
                            </span>
                        </div>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                <tr>
                                    <th>Üniversite</th>
                                    <th>Birim</th>
                                    <th class="text-end">Öğrenci</th>
                                    <th class="text-end">Kadın</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var k in Model.Kurumlar)
                                {
                                    <tr>
                                        <td style="font-weight:500;">@k.universite</td>
                                        <td style="color:var(--metin-ikincil); font-size:12px;">@k.birim</td>
                                        <td class="text-end num" style="font-weight:600;">
                                            @((k.toplam_toplam ?? 0).ToString("N0"))
                                        </td>
                                        <td class="text-end num" style="color:var(--metin-ikincil);">
                                            %@Bicim.Yuzde(k.KadinOrani)
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
