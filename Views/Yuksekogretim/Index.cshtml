@model List<YokIstatistikWeb.Models.Universite>
@using YokIstatistikWeb.Services
@{
    ViewData["Title"] = "Üniversiteler";

    // YÖK'ün resmî üniversite toplamı kullanılıyor; birimleri toplamak kaynak
    // verideki tutarsızlıklar yüzünden bazı yıllarda sapıyor.
    int Toplam(YokIstatistikWeb.Models.Universite u) => u.toplam_toplam ?? 0;

    var toplamKurum = Model.Count;
    var toplamKisi = Model.Sum(Toplam);
    var enBuyukler = Model.OrderByDescending(Toplam).Take(10).ToList();
    var enYuksek = enBuyukler.FirstOrDefault() is { } ilk ? Math.Max(Toplam(ilk), 1) : 1;

    var turRenkleri = new Dictionary<string, string>
    {
        ["DEVLET"] = "var(--seri-1)", ["VAKIF"] = "var(--seri-2)", ["VAKIF MYO"] = "var(--seri-3)"
    };
    string TurRengi(string? t) => t is not null && turRenkleri.TryGetValue(t, out var r) ? r : "var(--metin-soluk)";

    var grafikVerisi = System.Text.Json.JsonSerializer.Serialize(
        enBuyukler.Select(u => new { ad = u.universite, deger = Toplam(u) }));
}

<div class="page-header">
    <div class="container">
        <div class="ust-etiket">@ViewBag.YilGoster öğretim yılı</div>
        <h2>Üniversiteler</h2>
        <p class="lead mb-0">Akademik unvan ve cinsiyet kırılımında öğretim elemanı sayıları</p>
    </div>
</div>

<div class="container">

    @if (TempData["Error"] is string hata)
    {
        <div class="alert alert-danger">@hata</div>
    }

    <!-- FİLTRELER — sunucu tarafında uygulanıyor, URL'de taşınıyor -->
    <form method="get" class="filter-form">
        <input type="hidden" name="year" value="@ViewBag.Yil" />
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label" for="search">Üniversite ara</label>
                <input type="text" class="form-control" id="search" name="search"
                       value="@ViewBag.Arama" placeholder="Ad ile ara…" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="tur">Tür</label>
                <select class="form-select" id="tur" name="tur">
                    <option value="">Tümü</option>
                    @foreach (var t in (List<string>)ViewBag.Turler)
                    {
                        <option value="@t" selected="@(t == (string?)ViewBag.SeciliTur)">@IstatistikServisi.TurGoster(t)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="sehir">Şehir</label>
                <select class="form-select" id="sehir" name="sehir">
                    <option value="">Tümü</option>
                    @foreach (var s in (List<string>)ViewBag.Sehirler)
                    {
                        <option value="@s" selected="@(s == (string?)ViewBag.SeciliSehir)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-primary">Filtrele</button>
            </div>
        </div>
    </form>

    <div class="row g-4">
        <!-- TABLO -->
        <div class="col-lg-7">
            <div class="card">
                <div class="kart-baslik d-flex justify-content-between align-items-baseline">
                    <div class="card-title">Kurumlar</div>
                    <span class="num" style="font-size:12.5px; color:var(--metin-ikincil);">
                        @toplamKurum kurum · @toplamKisi.ToString("N0") öğretim elemanı
                    </span>
                </div>

                @if (toplamKurum == 0)
                {
                    <div class="card-body">
                        <p class="card-text mb-0">Bu filtrelerle eşleşen kurum bulunamadı.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                            <tr>
                                <th>Üniversite</th>
                                <th>Tür</th>
                                <th>Şehir</th>
                                <th class="text-end">Öğr. elemanı</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var uni in Model)
                            {
                                <tr>
                                    <td style="font-weight:500;">
                                        <a href="@Url.Action("Detay", "Yuksekogretim", new { id = uni.Id, year = ViewBag.Yil })">
                                            @uni.universite
                                        </a>
                                    </td>
                                    <td>
                                        <span class="d-inline-flex align-items-center gap-2"
                                              style="font-size:12px; color:var(--metin-ikincil);">
                                            <span class="seri-nokta" style="background:@TurRengi(uni.tur);"></span>
                                            @IstatistikServisi.TurGoster(uni.tur)
                                        </span>
                                    </td>
                                    <td style="color:var(--metin-ikincil);">
                                        @(string.IsNullOrWhiteSpace(uni.sehir) ? "—" : uni.sehir)
                                    </td>
                                    <td class="text-end num" style="font-weight:600;">@Toplam(uni).ToString("N0")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- EN BÜYÜK 10 -->
        <div class="col-lg-5">
            <div class="card mb-4">
                <div class="kart-baslik">
                    <div class="card-title">En çok öğretim elemanı</div>
                    <div class="kart-alt">Filtreye uyan ilk 10 kurum</div>
                </div>
                <div class="card-body">
                    @foreach (var u in enBuyukler)
                    {
                        var oran = (double)Toplam(u) / enYuksek * 100;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-baseline gap-3 mb-1">
                                <span style="font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                    @u.universite
                                </span>
                                <span class="num" style="font-size:12px; font-weight:600; flex-shrink:0;">
                                    @Toplam(u).ToString("N0")
                                </span>
                            </div>
                            <div class="cubuk" style="height:8px;">
                                <div class="cubuk-dolu"
                                     style="width:@oran.ToString("N1", System.Globalization.CultureInfo.InvariantCulture)%; background:var(--seri-1);"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="chart-container">
                <h5>Dağılım</h5>
                <div class="kart-alt mb-3">İlk 10 kurumun payı</div>
                <div id="pasta" style="width:100%; height:300px;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.gstatic.com/charts/loader.js"></script>
    <script>
        const enBuyukler = @Html.Raw(grafikVerisi);

        // language: 'tr' -> binlik ayıracı nokta; sitenin geri kalanıyla tutarlı
        google.charts.load('current', { packages: ['corechart'], language: 'tr' });
        google.charts.setOnLoadCallback(function () {
            if (!enBuyukler.length) return;

            const veri = new google.visualization.DataTable();
            veri.addColumn('string', 'Üniversite');
            veri.addColumn('number', 'Öğretim elemanı');
            enBuyukler.forEach(u => veri.addRow([u.ad, u.deger]));

            new google.visualization.PieChart(document.getElementById('pasta')).draw(veri, {
                // Doğrulanmış kategorik palet; sıra sabit, döngüye girmiyor
                colors: ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4',
                         '#4a3aa7', '#e34948', '#008300', '#5b9add', '#c98500'],
                pieHole: 0.45,
                chartArea: { width: '92%', height: '86%' },
                legend: { position: 'none' },
                pieSliceText: 'none',
                tooltip: { textStyle: { fontName: 'IBM Plex Sans', fontSize: 12 } },
                backgroundColor: 'transparent'
            });
        });
    </script>
}
